# ==============================================================================
# CountryRush — Frontend Public Environment Variables (Vite)
# ==============================================================================
# Copy this file to `.env.local` for local development.
# Note: CountryRush uses Vite (not Next.js), so browser env vars use `VITE_*`
# instead of `NEXT_PUBLIC_*`.
#
# CRITICAL SECURITY NOTICE:
# - Every variable prefixed with `VITE_` is bundled into public browser JavaScript.
# - ONLY place public, client-safe configuration here.
# - NEVER add SUPABASE_SERVICE_ROLE_KEY, sb_secret_*, or Cloudflare secrets.
# ==============================================================================

# Supabase Public Project Configuration (Phase 2: Supabase Auth + RLS Profiles)
# Accepts either VITE_SUPABASE_PUBLISHABLE_KEY (`sb_publishable_...`) or legacy VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Set to `true` once Cloudflare Workers API is running (`wrangler dev` or deployed URL)
VITE_ENABLE_BACKEND=false

# Cloudflare Workers API & WebSocket Endpoints (Phase 3+: Workers + Durable Objects)
VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_WS_BASE_URL=ws://127.0.0.1:8787
